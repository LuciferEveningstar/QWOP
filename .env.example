# Vorlage für lokale Umgebungs-Variablen.
# Kopiere diese Datei zu .env und fülle die Werte aus. .env ist gitignored.

# --- Weights & Biases ---
# Holst du dir auf https://wandb.ai/authorize
WANDB_API_KEY=

# Standard-Projekt für alle Trainingsläufe
WANDB_PROJECT=qwop-rl-dhbw

# Standard-Entity (= Team-Workspace oder dein User-Name)
WANDB_ENTITY=

# Optional: "online" (Default), "offline" oder "disabled"
# offline = nur lokal loggen, später per `wandb sync` hochladen
# disabled = komplett aus
# WANDB_MODE=online
